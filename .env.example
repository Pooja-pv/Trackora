# Generate a fresh key for your local environment; never commit .env.
DJANGO_SECRET_KEY=replace-this-with-a-generated-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite is convenient for local development. Use PostgreSQL in deployment.
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
